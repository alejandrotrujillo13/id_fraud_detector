# Copy to .env and fill in. .env is git-ignored.
#
# AWS access uses your SSO session: run `aws sso login` before the scripts.
# No access keys and no database password go in this file.

# Environment to read from. The database is sisteya_<STAGE>: dev, test or live.
STAGE=dev

# Salt used to anonymize document numbers. Generate once, never change it:
#   python -c "import secrets; print(secrets.token_hex(32))"
ANON_SALT=

# Only for scripts/14_fresh_ocr.py: the account that pays for Rekognition. It must be a different
# account from the SSO one. Both values are required and there is no default: the script stops
# when either is blank, or when the profile's keys belong to another account.
# Name of its AWS profile. Only the NAME goes here; its keys stay in ~/.aws/credentials
# (aws configure --profile <name>).
REKOGNITION_PROFILE=
# Its 12-digit AWS account number (not a secret; shown at the top right of the AWS console).
REKOGNITION_ACCOUNT_ID=
# Region for Rekognition (default us-east-1).
REKOGNITION_REGION=

# --- Optional. Leave blank to use the defaults. ---
# AWS profile to use instead of the default one.
AWS_PROFILE=
# AWS region (default us-east-1).
AWS_REGION=
# Secrets Manager secret with host, port, username and password (default sisteya_db_proxy_credentials).
DB_SECRET_NAME=
# Host and port to use instead of the ones in the secret (for example through a tunnel).
DB_HOST=
DB_PORT=
# Database name to use instead of sisteya_<STAGE>.
DB_NAME=
